# Google Gemini API Key (Required for local AI Agents)
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: Vertex AI / Google Cloud (used in place of GOOGLE_API_KEY for enterprise/cloud)
# GOOGLE_GENAI_USE_ENTERPRISE=TRUE
# GOOGLE_CLOUD_PROJECT=badya-f1af2
# GOOGLE_CLOUD_LOCATION=us-central1

# Firebase Admin Service Account Credentials Path (Optional, defaults to serviceAccountKey.json or GCP metadata)
GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json

# Stability AI API Key (Required for image generation in stories)
STABILITY_API_KEY=your_stability_api_key_here
STABILITY_API_HOST=https://api.stability.ai

# Server Environment Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
